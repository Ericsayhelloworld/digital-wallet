# Copy to .env and change the values: cp .env.example .env
# Never commit .env to Git (SEC-6).

# Public port of the web container (API-1)
WEB_PORT=8080

# PostgreSQL
POSTGRES_ADMIN_USER=postgres
POSTGRES_ADMIN_PASSWORD=change-me-admin
AUTH_DB_PASSWORD=change-me-auth
WALLET_DB_PASSWORD=change-me-wallet
NOTIFICATION_DB_PASSWORD=change-me-notification

# auth-service: administrator created at startup (AUTH-5)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-admin-password
JWT_ISSUER=http://auth-service:8081

# wallet-service <-> bank-simulator (SEC-4)
BANK_API_KEY=change-me-bank-api-key
BANK_WEBHOOK_SECRET=change-me-webhook-secret

# Grafana administrator (the dashboard itself is readable without login)
GRAFANA_ADMIN_PASSWORD=change-me-grafana
